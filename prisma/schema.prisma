// prisma/schema.prisma
// IMPORTANT: AFTER SAVING THIS FILE, YOU MUST RUN IN YOUR TERMINAL:
// 1. npx prisma format
// 2. npx prisma generate
// 3. npx prisma db push
// 4. Restart your Next.js development server

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum StaffCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

// --- POS ENUMS ---
enum OrderType {
  TABLE
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  KHQR
}

enum OrderStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED
}

// --- USER MODEL ---
model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  failedAttempts   Int       @default(0)
  lockoutUntil     DateTime?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  isSuperAdmin     Boolean   @default(false)
  role             String    @default("staff") // "admin" | "staff"
  createdBy        String?

  shopUsers        ShopUser[]
  orders           Order[]
}

// --- NEW SAAS MODELS ---
model Shop {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  plan        String    @default("FREE")
  planId      String?
  status      String    @default("ACTIVE")
  trialEndsAt DateTime?
  paidUntil   DateTime?

  // --- DEMO SHOP AUTODELETE ---
  isDemo      Boolean   @default(false)
  expiresAt   DateTime?

  // LIMIT OVERRIDES
  overrideMaxProducts   Int?
  overrideMaxCategories Int?
  overrideMaxBanners    Int?
  overrideHeaderStyle   String?

  // STAFF CALL & NOTIFICATIONS
  telegramNotificationsEnabled Boolean @default(false)
  callStaffEnabled             Boolean @default(true)
  telegramChatId               String?
  staffCallTopicId             String?
  newOrderTopicId              String?
  
  staffCalls StaffCallRequest[] @relation("ShopStaffCalls")
  tables     Table[]            @relation("ShopTables")

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  shopUsers   ShopUser[]
  categories  Category[]
  products    Product[]
  settings    ShopSettings?
  banners     Banner[]
  orders      Order[]
  
  // INVENTORY RELATIONS
  ingredients Ingredient[]
  stockLogs   StockLog[]
}

model ShopUser {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
}

model Invite {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String?
  shopName  String?
  slug      String?
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- EXISTING MODELS (SCOPED TO SHOP) ---
model Category {
  id        String  @id @default(cuid())
  name      String
  name_kh   String?
  name_zh   String?
  sortOrder Int     @default(0)
  discount  Float   @default(0)
  isDrink   Boolean @default(false)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  products Product[]
}

// --- PRODUCT RELATIONS ---
model ProductVariant {
  id        String  @id @default(cuid())
  name      String
  price     Float
  
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductIngredient {
  id           String     @id @default(cuid())
  
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  
  quantityUsed Float      // How much of this ingredient is used per 1 order of this product

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  name_kh     String?
  name_zh     String?
  price       Float   // Kept as base/fallback price
  image       String
  time        String?
  rating      Float   @default(0)
  description String?
  isPopular   Boolean @default(false)
  isSoldOut   Boolean @default(false)
  discount    Float   @default(0)

  variants    ProductVariant[]
  ingredients ProductIngredient[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  orderItems OrderItem[]
}

// --- PROMOTIONAL BANNER MODEL ---
model Banner {
  id        String    @id @default(cuid())
  image     String
  sortOrder Int       @default(0)
  deletedAt DateTime?
  
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ShopSettings {
  id            String  @id @default(cuid())
  name          String
  name_kh       String?
  nameDisplay   String  @default("EN")
  address       String?
  phone         String?
  openingHours  String?
  themeColor    String  @default("#000000")
  headerDesign  String  @default("design1")
  logo          String?
  logoType      String  @default("withBackground")
  socials       String  @default("[]")
  facebook      String?
  showFacebook  Boolean @default(false)
  instagram     String?
  showInstagram Boolean @default(false)
  telegram      String?
  showTelegram  Boolean @default(false)

  shopId String @unique
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// --- PLAN MODEL ---
model Plan {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  priceMonthly  Float   @default(0)
  priceYearly   Float   @default(0)
  status        String  @default("ACTIVE")
  order         Int     @default(0)
  allowTrial    Boolean @default(false)
  trialDays     Int     @default(14)
  isRecommended Boolean @default(false)

  // LIMITS
  maxProducts   Int @default(0)
  maxCategories Int @default(0)
  maxBanners    Int @default(0)
  maxQrThemes   Int @default(0)
  aiUploadLimit Int @default(0)

  // FEATURE TOGGLES
  featPreparationTime  Boolean @default(false)
  featCampaign         Boolean @default(false)
  featCoverBanner      Boolean @default(false)
  featSmartCategories  Boolean @default(false)
  featUploadImageMenu  Boolean @default(false)
  featAlertBarista     Boolean @default(false)
  featPos              Boolean @default(false)
  featOrderFromTable   Boolean @default(false)
  featMultipleLanguage Boolean @default(false)
  featCustomDomain     Boolean @default(false)
  featDedicatedSupport Boolean @default(false)
  featAiUpload         Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Table {
  id         String             @id @default(cuid())
  shopId     String
  shop       Shop               @relation("ShopTables", fields: [shopId], references: [id], onDelete: Cascade)
  label      String
  isActive   Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  staffCalls StaffCallRequest[] @relation("TableStaffCalls")

  @@unique([shopId, label])
  @@index([shopId])
}

model StaffCallRequest {
  id         String          @id @default(cuid())
  shopId     String
  shop       Shop            @relation("ShopStaffCalls", fields: [shopId], references: [id], onDelete: Cascade)
  tableId    String
  table      Table           @relation("TableStaffCalls", fields: [tableId], references: [id], onDelete: Cascade)
  status     StaffCallStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  resolvedAt DateTime?

  // TELEGRAM AUTO-DELETE TRACKING
  telegramMessageId String?
  telegramChatId    String?
  telegramSentAt    DateTime?

  @@index([shopId])
  @@index([tableId])
  @@index([shopId, tableId, createdAt])
  @@index([status, createdAt])
}

// --- POS ORDER MODELS ---
model Order {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  orderNumber     String?

  userId          String?       // Track which staff member processed the order
  user            User?         @relation(fields: [userId], references: [id])

  // POS Specific Fields
  orderType       OrderType     @default(TABLE)
  tableNumber     String?
  deliveryAgent   String?
  
  // Financials
  subtotal        Float
  discount        Float         @default(0)
  promoCode       String?
  tax             Float         @default(0)
  total           Float
  currency        String        @default("USD") // ADDED EXPLICIT CURRENCY
  
  // Status & Payment
  paymentMethod   PaymentMethod @default(CASH)
  status          OrderStatus   @default(PENDING)
  isPaid          Boolean       @default(false)
  
  // Relation to items
  items           OrderItem[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([shopId])
  @@index([userId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  name            String   // Storing the name historically in case product name changes later
  price           Float    // Storing the exact price at the time of purchase
  quantity        Int
  
  // POS Specific Fields
  notes           String?  @db.Text
  
  // Store customizations (mood, size, sugar, ice) as a flexible JSON object
  customization   Json?

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// --- INVENTORY MODELS ---
model Ingredient {
  id            String     @id @default(cuid())
  shopId        String
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  name          String
  unit          String     // e.g., "kg", "liters", "pcs"
  current       Float      @default(0)
  max           Float      @default(100)
  lowThreshold  Float      @default(20) // percentage
  
  logs          StockLog[]
  productUses   ProductIngredient[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([shopId])
}

model StockLog {
  id             String     @id @default(cuid())
  shopId         String
  shop           Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  
  change         Float
  reason         String     // "Restock", "Sold", "Waste", "Manual"
  staffName      String
  previousStock  Float
  newStock       Float
  
  timestamp      DateTime   @default(now())

  @@index([shopId])
  @@index([ingredientId])
}